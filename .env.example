# LineRelay — exemple de configuration.
# Copiez ce fichier en `.env` et adaptez les valeurs si besoin.
#
#   cp .env.example .env
#
# Aucune de ces variables n'est un secret : LineRelay n'utilise aucune clé
# d'API. Elles sont externalisées pour permettre de pointer vers un autre
# réseau ou un autre fournisseur de flux sans toucher au code.
#
# Note : le serveur ne charge pas lui-même le fichier .env. Exportez les
# variables avant de lancer (`set -a; . ./.env; set +a; npm start`) ou
# utilisez un gestionnaire de process (PM2, systemd) qui les injecte.

# Port d'écoute du serveur HTTP.
PORT=3000

# Flux GTFS-RT « vehicle position » (positions temps réel des véhicules).
# Par défaut : proxy open data de transport.data.gouv.fr pour le réseau de Dijon.
VEHICLE_FEED_URL=https://proxy.transport.data.gouv.fr/resource/divia-dijon-gtfs-rt-vehicle-position

# Flux GTFS-RT « trip update » (retards et arrêts supprimés).
TRIPUPDATE_FEED_URL=https://proxy.transport.data.gouv.fr/resource/divia-dijon-gtfs-rt-trip-update

# Disponibilités temps réel des vélos en libre-service (backend Cykleo).
# Laisser vide pour désactiver complètement la couche vélos.
VELODI_FEED_URL=https://portail.cykleo.fr/pu/stations/availability
# Identifiant d'organisation Cykleo (1 = Dijon).
VELODI_ORG_ID=1

# Jeu de données GTFS statique utilisé par `npm run build:traces`
# pour générer les tracés des lignes (public/traces.json).
GTFS_STATIC_URL=https://www.data.gouv.fr/api/1/datasets/r/e0dbd217-15cd-4e28-9459-211a27511a34
