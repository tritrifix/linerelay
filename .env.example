# LineRelay — exemple de configuration.
# Copiez ce fichier en `.env` et adaptez les valeurs si besoin.
#
#   cp .env.example .env
#
# Aucune de ces variables n'est un secret : LineRelay n'utilise aucune clé
# d'API. Elles sont externalisées pour permettre de pointer vers un autre
# réseau ou un autre fournisseur de flux sans toucher au code.
#
# Note : le serveur lit ce fichier au démarrage. Une variable déjà présente
# dans l'environnement l'emporte toujours sur le fichier, ce qui permet une
# surcharge ponctuelle : `PORT=8080 npm start`.

# ----------------------------------------------------------------------------
# Port d'écoute du serveur HTTP — le seul réglage à changer pour déplacer
# l'application, en développement comme en production :
#
#   dev local    npm start   /   npm run dev   /   ./start.sh
#   dev Docker   docker compose up   /   make dev      (conteneur + hôte)
#   production   docker compose -f compose.prod.yaml up -d   /   make deploy
#
# Sans éditer ce fichier, pour un lancement seulement :
#   PORT=8080 npm start        PORT=8080 make dev        PORT=8080 make deploy
#
# PORT=0 laisse le système choisir un port libre (affiché au démarrage).
# ----------------------------------------------------------------------------
PORT=3000

# Flux GTFS-RT « vehicle position » (positions temps réel des véhicules).
# Par défaut : proxy open data de transport.data.gouv.fr pour le réseau de Dijon.
VEHICLE_FEED_URL=https://proxy.transport.data.gouv.fr/resource/divia-dijon-gtfs-rt-vehicle-position

# Flux GTFS-RT « trip update » (retards et arrêts supprimés).
TRIPUPDATE_FEED_URL=https://proxy.transport.data.gouv.fr/resource/divia-dijon-gtfs-rt-trip-update

# Disponibilités temps réel des vélos en libre-service (backend Cykleo).
# Laisser vide pour désactiver complètement la couche vélos.
VELODI_FEED_URL=https://portail.cykleo.fr/pu/stations/availability
# Identifiant d'organisation Cykleo (1 = Dijon).
VELODI_ORG_ID=1

# Jeu de données GTFS statique utilisé par `npm run build:traces` et par le
# build de l'image Docker pour générer les tracés des lignes (public/traces.json).
GTFS_STATIC_URL=https://www.data.gouv.fr/api/1/datasets/r/e0dbd217-15cd-4e28-9459-211a27511a34

# ----------------------------------------------------------------------------
# Docker / Compose — lu par `docker compose`, pas par l'application.
# Voir docs/DOCKER.md.
# ----------------------------------------------------------------------------

# Port publié sur la machine hôte. Laissé commenté, il suit PORT : un seul
# réglage suffit. Ne le définissez que pour dissocier les deux côtés, par
# exemple publier sur 80 alors que le conteneur écoute sur PORT.
# HOST_PORT=8080

# Fuseau horaire du conteneur.
TZ=Europe/Paris

# Image déployée en production (compose.prod.yaml). Épinglez une version
# précise pour un déploiement reproductible et un retour arrière immédiat.
LINERELAY_IMAGE=ghcr.io/tritrifix/linerelay:latest

# Mettre à 1 pour construire l'image sans réseau : les tracés ne sont alors
# pas générés et la carte s'affiche sans les polylignes des lignes.
SKIP_TRACES=0
