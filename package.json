{
  "name": "linerelay",
  "version": "1.0.0",
  "description": "LineRelay — carte interactive temps réel des transports en commun de Dijon Métropole.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:traces": "python3 tools/build_traces.py",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker build -t linerelay:dev .",
    "docker:deploy": "docker compose -f compose.prod.yaml pull && docker compose -f compose.prod.yaml up -d"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["divia", "dijon", "gtfs-rt", "navitia", "leaflet", "bus", "temps-reel"],
  "license": "ISC",
  "dependencies": {
    "divia-api": "^3.0.3",
    "express": "^5.2.1",
    "gtfs-realtime-bindings": "^1.1.1"
  }
}
